# ══════════════════════════════════════════════
# BillsDatacard Environment Variables
# ══════════════════════════════════════════════

# ── Server ──
PORT=4000
NODE_ENV=development
# ALLOWED_ORIGIN=https://yourdomain.com (comma-separated, production only)

# ── Mobile App API URL ──
# Local Android emulator: http://10.0.2.2:4000
# iOS simulator: http://localhost:4000
# Production: https://yourdomain.com
VITE_API_URL=http://localhost:4000

# ── Reloadly API ──
RELOADLY_ENV=sandbox
RELOADLY_SANDBOX_CLIENT_ID=
RELOADLY_SANDBOX_CLIENT_SECRET=
RELOADLY_PROD_CLIENT_ID=
RELOADLY_PROD_CLIENT_SECRET=

# ── Paystack ──
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── JWT ──
JWT_SECRET=change-this-to-a-strong-random-string

# ── Google OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Gmail SMTP) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ── Web Push Notifications ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
