# ══════════════════════════════════════════════
# BillsDatacard Environment Variables
# ══════════════════════════════════════════════

# ── Server ──
PORT=4000
NODE_ENV=development
# ALLOWED_ORIGIN=https://yourdomain.com (comma-separated, production only)

# ── Mobile App API URL ──
# Local Android emulator: http://10.0.2.2:4000
# iOS simulator: http://localhost:4000
# Production: https://yourdomain.com
VITE_API_URL=http://localhost:4000

# ── Reloadly API ──
RELOADLY_ENV=sandbox
RELOADLY_SANDBOX_CLIENT_ID=your_reloadly_sandbox_client_id
RELOADLY_SANDBOX_CLIENT_SECRET=your_reloadly_sandbox_client_secret
RELOADLY_PROD_CLIENT_ID=
RELOADLY_PROD_CLIENT_SECRET=

# ── Paystack ──
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# ── JWT ──
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_at_least_64_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_at_least_64_chars

# ── Google OAuth ──
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Email (Gmail SMTP) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password

# ── Web Push Notifications ──
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
