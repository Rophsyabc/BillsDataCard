# Reloadly API Credentials
RELOADLY_ENV=sandbox
RELOADLY_SANDBOX_CLIENT_ID=
RELOADLY_SANDBOX_CLIENT_SECRET=
RELOADLY_PROD_CLIENT_ID=
RELOADLY_PROD_CLIENT_SECRET=

# Paystack Configuration
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# JWT Authentication
JWT_SECRET=your-jwt-secret-here

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Web Push Notifications (https://web-push-codelab.glitch.me/)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Server
PORT=4000

# Mobile App API URL (set to your deployed server URL for production builds)
# For local Android emulator, use: http://10.0.2.2:4000
# For iOS simulator, use: http://localhost:4000
# VITE_API_URL=http://your-server-url.com
