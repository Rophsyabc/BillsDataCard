# Production environment variables

# Server
PORT=3000
NODE_ENV=production

# Allowed origins (comma-separated for CORS)
ALLOWED_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Reloadly API Credentials
RELOADLY_ENV=production
RELOADLY_PROD_CLIENT_ID=your_reloadly_client_id
RELOADLY_PROD_CLIENT_SECRET=your_reloadly_client_secret

# Paystack Configuration
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# JWT Authentication
JWT_SECRET=your_strong_random_secret_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Web Push Notifications
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Mobile App API URL (set to your server URL)
VITE_API_URL=https://billspaymobile.firstlovestudios.com
