# ══════════════════════════════════════════════
# BillsDatacard Production Environment Variables
# ══════════════════════════════════════════════

# ── Server ──
PORT=3000
NODE_ENV=production

# ── CORS ──
ALLOWED_ORIGIN=https://your-production-domain.com

# ── Mobile App & Frontend URL ──
VITE_API_URL=https://your-production-api-url.com

# ── Reloadly API ──
RELOADLY_ENV=production
RELOADLY_PROD_CLIENT_ID=your_reloadly_prod_client_id
RELOADLY_PROD_CLIENT_SECRET=your_reloadly_prod_client_secret

# ── Paystack ──
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# ── JWT ──
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_at_least_64_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_at_least_64_chars

# ── Google OAuth ──
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Email (Gmail SMTP) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password

# ── Web Push Notifications ──
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
