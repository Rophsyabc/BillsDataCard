# ══════════════════════════════════════════════
# BillsDatacard Production Environment Variables
# ══════════════════════════════════════════════

# ── Server ──
PORT=4000
NODE_ENV=production

# ── Canonical Application URL ──
APP_URL=https://billsdatacard.onrender.com

# ── CORS ──
# Comma-separated list of additional frontend origins allowed to access the API.
# In production, only APP_URL is allowed by default.
ALLOWED_ORIGIN=https://billsdatacard.onrender.com

# ── Frontend API URL (embedded in Vite build) ──
VITE_API_URL=https://billsdatacard.onrender.com

# ── Google OAuth (for Google Sign-In button) ──
# NOTE: VITE_ prefix vars are embedded in the frontend build at build time
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Reloadly API ──
RELOADLY_ENV=production
RELOADLY_PROD_CLIENT_ID=your_reloadly_prod_client_id
RELOADLY_PROD_CLIENT_SECRET=your_reloadly_prod_client_secret

# ── Paystack ──
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# ── JWT ──
JWT_SECRET=your_jwt_secret_at_least_64_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_at_least_64_chars

# ── Google OAuth (server-side) ──
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Email (Gmail SMTP) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password

# ── Web Push Notifications ──
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
