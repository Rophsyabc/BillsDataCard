{
  "appId": "com.soardev.billsdatacard",
  "appName": "BillsDatacard",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 2000,
      "backgroundColor": "#ffffff",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": true,
      "spinnerColor": "#3B82F6"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#3B82F6"
    }
  }
}
